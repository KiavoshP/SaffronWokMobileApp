<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SaffronWok.Mobile.SplashPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SaffronWok.Mobile.Controls"
    BackgroundColor="{StaticResource BgCanvas}"
    NavigationPage.HasNavigationBar="False">

    <Grid x:Name="root" Background="{StaticResource SplashBackgroundBrush}">

        <!-- Ambient Pulsing Glow -->
        <Ellipse
            x:Name="glow"
            WidthRequest="230"
            HeightRequest="230"
            Fill="#26F59E0B"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <!-- Centered Brand & Progress Stack -->
        <VerticalStackLayout
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Padding="32"
            Spacing="0">

            <!-- SaffronWok Emblem -->
            <controls:SaffronLogoView x:Name="emblem" Size="76" HasGlow="True" HorizontalOptions="Center" />

            <!-- Wordmark -->
            <Label
                Margin="0,24,0,0"
                HorizontalTextAlignment="Center"
                FontSize="30"
                FontAttributes="Bold">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Saffron" TextColor="{StaticResource TextPrimary}" />
                        <Span Text="Wok" TextColor="{StaticResource AccentAmberBright}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <!-- Subtitle -->
            <Label
                Margin="0,4,0,0"
                Text="PERSIAN × VIETNAMESE CHARCOAL GRILL"
                FontSize="11"
                FontAttributes="Bold"
                CharacterSpacing="2.2"
                TextColor="#E6FCD34D"
                HorizontalTextAlignment="Center" />

            <!-- Smooth Progress Track -->
            <VerticalStackLayout Margin="0,40,0,0" WidthRequest="240" Spacing="10" HorizontalOptions="Center">
                <Border
                    HeightRequest="6"
                    StrokeShape="RoundRectangle 999"
                    BackgroundColor="#27272A"
                    Stroke="#3F3F46"
                    StrokeThickness="1"
                    Padding="0">
                    <BoxView
                        x:Name="progressFill"
                        HorizontalOptions="Start"
                        WidthRequest="0"
                        HeightRequest="6"
                        CornerRadius="3"
                        Color="{StaticResource AccentAmber}" />
                </Border>

                <Label
                    Text="Warming up the charcoal &amp; fetching live menu..."
                    FontSize="11"
                    TextColor="{StaticResource TextMuted}"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </Grid>
</ContentPage>
