<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SaffronWok.Mobile.RewardsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SaffronWok.Mobile"
    Title="Rewards">

    <ScrollView HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="16" Spacing="20">

            <VerticalStackLayout Spacing="2">
                <Label Text="SaffronWok Rewards" Style="{StaticResource PageTitleLabel}" />
            </VerticalStackLayout>

            <!-- Ember Club Loyalty Banner -->
            <Border
                Stroke="{StaticResource BorderAmberBrush}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="20"
                Background="{StaticResource EmberClubCardBrush}">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="🔥 EMBER CLUB" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                    </Grid>
                    <Label x:Name="pendingRewards" Text="Loyalty balances and redemptions are coming soon."
                           TextColor="{StaticResource TextPrimary}" />
                    <VerticalStackLayout x:Name="sampleBalance" IsVisible="False" Spacing="6">
                        <Label x:Name="balance" FontSize="36" FontFamily="InterExtraBold" />
                        <Label x:Name="goal" FontSize="12" />
                        <ProgressBar x:Name="progress" ProgressColor="{StaticResource TextPrimary}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout x:Name="samplePerks" IsVisible="False" Spacing="12">
                <Label Text="SAMPLE PERKS" Style="{StaticResource SectionHeaderLabel}" />
                <VerticalStackLayout x:Name="perkList" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:DemoPerk">
                            <Border Style="{StaticResource SurfaceCard}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Name}" FontFamily="InterBold" />
                                        <Label Text="{Binding Description}" Style="{StaticResource MutedCaptionLabel}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Points, StringFormat='{0} pts'}"
                                           TextColor="{StaticResource AccentAmberBright}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
