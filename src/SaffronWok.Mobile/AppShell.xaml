<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="SaffronWok.Mobile.AppShell"
       BackgroundColor="{StaticResource BgCanvas}"
       ForegroundColor="{StaticResource AccentAmberBright}"
       TitleColor="{StaticResource TextPrimary}"
       TabBarBackgroundColor="{StaticResource BgCanvas}"
       TabBarForegroundColor="{StaticResource AccentAmberBright}"
       TabBarTitleColor="{StaticResource AccentAmberBright}"
       TabBarUnselectedColor="{StaticResource TextMuted}"
       FlyoutBackgroundColor="{StaticResource BgCanvas}"
       FlyoutWidth="192">
    <Shell.FlyoutFooter>
        <Border Margin="12" Padding="12" Stroke="{StaticResource BorderSubtleBrush}"
                StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource BgSurface}">
            <Label Text="Charcoal Live" FontAttributes="Bold" TextColor="{StaticResource AccentAmberBright}" />
        </Border>
    </Shell.FlyoutFooter>
</Shell>
